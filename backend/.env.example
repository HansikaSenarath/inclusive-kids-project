# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection
# Either set DATABASE_URL, or the individual PGHOST/PGPORT/... vars below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inclusive_kids_hub

PGHOST=localhost
PGPORT=5432
PGDATABASE=inclusive_kids_hub
PGUSER=postgres
PGPASSWORD=postgres
